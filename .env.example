# Site (build args in CI)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 1 on the temporary domain (also forced when the host starts with "new.")
NEXT_PUBLIC_NOINDEX=1
# Build-time origin allowed by the CSP for Umami. Must match UMAMI_SCRIPT_URL's origin.
NEXT_PUBLIC_UMAMI_ORIGIN=https://analytics.8move.com

# Shared admin (8move) ingest API
ADMIN_API_URL=https://admin.example.com
TRIDENT_API_TOKEN=change-me

# Email: smtp | resend
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASS=change-me
SMTP_FROM=noreply@example.com
RESEND_API_KEY=re_your_key_here
CONTACT_NOTIFICATION_EMAIL=sales@example.com

# Umami analytics (runtime env, read by /api/umami-config)
UMAMI_WEBSITE_ID=
UMAMI_SCRIPT_URL=https://analytics.8move.com/script.js

# Optional HTTP basic auth for the staging site (user:password)
BASIC_AUTH_CREDENTIALS=
